# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real keys.
# This .example file IS committed, so keep it full of placeholders only.

# Get from https://aistudio.google.com (free, no credit card)
GEMINI_API_KEY=your_gemini_key_here

# Optional but strongly recommended: a second provider so a Gemini quota
# limit doesn't stop the app. Free, no credit card: https://console.groq.com
# Without it the app still runs — it just has fewer models to fall back to.
GROQ_API_KEY=your_groq_key_here

# Get from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
